# Copy this file to ".env" for local runs and fill in your own keys.
# NEVER commit a real key. On Render, set these in the dashboard instead
# (see DEPLOY.md). Both keys are optional for trying the app:
# with no keys set, the app runs in DEMO MODE — it serves the pre-computed
# golden sample run and makes no live model or search calls.

# Nebius Token Factory API key (live Nemotron model calls)
NEBIUS_API_KEY=

# Tavily API key (live resource verification searches)
TAVILY_API_KEY=
